{
  "name": "dreamward",
  "private": true,
  "version": "0.6.0",
  "license": "AGPL-3.0-only",
  "description": "Dreamward — a private life-design book: vision, chapters, IKIGAI, goals and your own AI. Desktop or self-hosted.",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev:api": "pnpm --filter @dreamward/api dev",
    "dev:web": "pnpm --filter @dreamward/web dev",
    "migrate": "pnpm --filter @dreamward/api migrate",
    "seed": "pnpm --filter @dreamward/api seed"
  },
  "devDependencies": {
    "turbo": "^2.11.5",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "sharp",
      "esbuild",
      "electron"
    ],
    "ignoredBuiltDependencies": [
      "better-sqlite3"
    ],
    "overrides": {
      "markdown-it": "^14.3.1",
      "linkify-it": "^5.0.2",
      "postcss-selector-parser": "^6.1.3",
      "esbuild@<0.25.0": "^0.25.12",
      "esbuild@>=0.27.3 <0.28.1": "^0.28.2"
    }
  }
}
