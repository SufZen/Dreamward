# ── Dreamward self-hosted settings ───────────────────────────────────────────
# install.sh writes this file for you (with generated secrets). Keep a copy
# in your password manager: without KEY_ENCRYPTION_SECRET, stored AI keys
# can't be decrypted after a restore.

# Version to run — pinned. `dreamward-ctl update` changes it safely.
DREAMWARD_VERSION=0.4.0
# IMAGE_REGISTRY=ghcr.io/sufzen

# ── Address ────────────────────────────────────────────────────────────────
# With a domain (automatic HTTPS via Caddy):
COMPOSE_PROFILES=https
DOMAIN=life.example.com
PUBLIC_ORIGIN=https://life.example.com
COOKIE_SECURE=true
# Without a domain (LAN / localhost / your own proxy or tunnel):
#   COMPOSE_PROFILES=
#   PUBLIC_ORIGIN=http://192.168.1.20:8080
#   COOKIE_SECURE=false
#   WEB_BIND=0.0.0.0        # 127.0.0.1 = only this machine (default)
#   WEB_PORT=8080

# ── Secrets (generate: openssl rand -hex 32) ───────────────────────────────
JWT_SECRET=
KEY_ENCRYPTION_SECRET=

# ── Accounts ───────────────────────────────────────────────────────────────
# The first admin is created in the browser via the one-time setup link
# printed on first start (`dreamward-ctl setup-link`).
MAX_USERS=10

# ── Backups ────────────────────────────────────────────────────────────────
BACKUP_HOUR=3
BACKUP_RETENTION_DAYS=14
TZ=UTC

# ── AI ─────────────────────────────────────────────────────────────────────
# Every user connects their OWN AI provider in Settings — the server pays for
# nothing. Allow local model servers (Ollama/LM Studio) on private addresses:
#   true  = allowed (home / single-user installs)
#   false = refused (recommended for servers shared with other people)
ALLOW_PRIVATE_AI_URLS=
# Reverse proxies in front of the API (rate limits use the real client IP):
#   auto = the bundled nginx, plus Caddy in https mode
#   2    = your own reverse proxy / tunnel in front of web (with --local)
TRUST_PROXY=auto
# Experimental "Sign in with ChatGPT" provider (unofficial — see docs).
CODEX_ENABLED=false

# ── Wording ────────────────────────────────────────────────────────────────
# A custom framework pack (docs/framework-packs.md), placed in ./packs/:
# FRAMEWORK_PACK_FILE=/packs/pack.json
FRAMEWORK_PACK_FILE=
