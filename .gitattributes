# Normalise line endings: LF in the repo and in shell scripts on every OS.
* text=auto eol=lf
*.sh text eol=lf
deploy/dreamward-ctl text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
# Binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.icns binary
*.db binary
*.pdf binary
