{
  "name": "@dreamward/desktop",
  "version": "0.5.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "productName": "Dreamward",
  "description": "Dreamward for Windows, macOS and Linux — your book, on your computer.",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "tsup && node scripts/assemble.mjs",
    "dev": "pnpm run build && electron .",
    "start": "electron .",
    "package": "node scripts/package.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"(desktop) no lint configured\" && exit 0"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.8.9",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@dreamward/api": "workspace:*",
    "@dreamward/web": "workspace:*",
    "@types/node": "^22.10.7",
    "electron": "^44.4.5",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3"
  }
}
