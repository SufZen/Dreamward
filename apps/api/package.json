{
  "name": "@dreamward/api",
  "version": "0.6.1",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "reset-password": "tsx src/scripts/reset-password.ts",
    "admin": "tsx src/scripts/admin.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "echo \"(api) no lint configured\" && exit 0"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@fastify/cookie": "^11.1.2",
    "@fastify/jwt": "^10.2.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^10.1.5",
    "@dreamward/shared": "workspace:*",
    "argon2": "^0.45.1",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "fflate": "^0.8.3",
    "sharp": "^0.35.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.7",
    "drizzle-kit": "^0.31.11",
    "tsup": "^8.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vitest": "^5.0.2"
  }
}
