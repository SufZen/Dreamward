{
  "name": "@dreamward/mcp",
  "version": "0.5.0",
  "license": "AGPL-3.0-only",
  "description": "MCP server for Dreamward — connect Claude, Codex, Gemini, Cursor and any MCP agent to your private life-vision system.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "dreamward",
    "ikigai",
    "personal-growth",
    "claude",
    "codex",
    "gemini"
  ],
  "type": "module",
  "bin": {
    "dreamward-mcp": "dist/index.js"
  },
  "exports": {
    ".": "./src/lib.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SufZen/Dreamward.git",
    "directory": "packages/mcp"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/lib.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "lint": "echo \"(mcp) no lint configured\" && exit 0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@dreamward/client": "workspace:*",
    "@dreamward/shared": "workspace:*",
    "@types/node": "^25.9.8",
    "tsup": "^8.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  }
}
