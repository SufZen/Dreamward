# ── Dreamward API environment ────────────────────────────────────────────────
# Copy to .env (root) for local dev; on the VPS /opt/dreamward/.env is created
# by scripts/deploy/setup-vps.sh with generated secrets.

# Node environment
NODE_ENV=development

# API server port
PORT=4000

# Where the control DB + per-user data live.
# Layout: $DATA_DIR/control.db, $DATA_DIR/users/<uid>/{lifebook.db,assets/}
# Local dev default: ./data at repo root. On the VPS (Docker): /data
DATA_DIR=./data

# Secret used to sign the session JWT. Generate a long random string:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret

# Encrypts LLM API keys / OAuth tokens at rest (AES-256-GCM).
# REQUIRED in production. Generate like JWT_SECRET. Rotating it invalidates
# stored provider keys (users re-enter them).
KEY_ENCRYPTION_SECRET=change-me-too

# Optional first admin account — used only while the control DB is empty.
# Leave both empty to create the admin in the browser instead: the server
# prints a one-time setup link (/setup?token=...) on first start.
# Additional users join via admin-generated invite links.
DREAMWARD_EMAIL=
DREAMWARD_PASSWORD=

# Backups (in-app, daily, verified) — defaults to $DATA_DIR/backups.
# Put it on a different disk/volume in production.
# BACKUP_DIR=./data/backups
# BACKUP_HOUR=3
# BACKUP_RETENTION_DAYS=14

# Hard cap on the number of accounts (invites refuse beyond this).
MAX_USERS=10

# Optional: the seed-admin-provider script reads the OpenRouter key from here
# to pre-configure the admin's AI provider. Never commit a real key.
ADMIN_OPENROUTER_KEY=

# Experimental "Sign in with ChatGPT" (Codex) provider. Off by default.
CODEX_ENABLED=false

# Set to "true" only behind HTTPS (production) so the session cookie is Secure.
COOKIE_SECURE=false

# Public origin of the web app (cookies/CORS + invite links in production).
# e.g. https://dreamward.yourdomain.com
PUBLIC_ORIGIN=http://localhost:5173

# Optional custom framework pack — the wording of the book (docs/framework-packs.md)
# FRAMEWORK_PACK_FILE=./private/my-pack.json
